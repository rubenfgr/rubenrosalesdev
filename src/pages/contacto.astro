---
import { Clock, Mail } from '@lucide/astro';
import ContactForm from '../components/ContactForm.astro';
import Section from '../components/Section.astro';
import { contactData, owner } from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto"
  description="Cuéntame qué quieres resolver. Te respondo con una primera valoración y, si tiene sentido, con los siguientes pasos."
>
  <Section
    as="h1"
    id="contacto"
    title="Cuéntame qué quieres resolver"
    lead="Describe el proceso o la idea con tus palabras. Te respondo con una primera valoración y, si tiene sentido, con los siguientes pasos."
  >
    <div class="layout">
      <ContactForm />
      <aside class="side" aria-label="Otras formas de contacto">
        <p><Mail size={20} stroke-width={1.5} aria-hidden="true" /> <span>Si prefieres escribirme directamente:<br /><a href={`mailto:${owner.email}`}>{owner.email}</a></span></p>
        <p><Clock size={20} stroke-width={1.5} aria-hidden="true" /> <span>{contactData.responseTime}</span></p>
      </aside>
    </div>
  </Section>
</Layout>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  .side {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border-width-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .side p { display: flex; gap: var(--space-3); align-items: flex-start; }
  .side :global(svg) { flex: none; color: var(--color-primary); margin-top: var(--space-1); }
  @media (min-width: 64rem) {
    .layout { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  }
</style>
