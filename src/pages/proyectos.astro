---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects', (p) => p.data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Proyectos"
  description="Sistemas en los que he trabajado, con el problema que resolvían y cómo se resolvió."
>
  <Section
    as="h1"
    id="proyectos"
    title="Proyectos"
    lead="Sistemas en los que he trabajado, con el problema que resolvían y cómo se resolvió."
  >
    {
      projects.length > 0 ? (
        <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
      ) : (
        <p>Estoy preparando esta sección. Si quieres conocer mi experiencia, <a href="/contacto">escríbeme</a>.</p>
      )
    }
  </Section>
</Layout>

<style>
  .grid { display: grid; gap: var(--grid-gutter); }
  @media (min-width: 40rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
