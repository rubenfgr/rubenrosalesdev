---
import type { Post } from '../lib/blog';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
  featuredFirst?: boolean;
}
const { posts, featuredFirst = false } = Astro.props;
---

{
  posts.length === 0 ? (
    <p>Todavía no hay artículos.</p>
  ) : (
    <div class="list">
      {posts.map((p, i) => <PostCard post={p} featured={featuredFirst && i === 0} level="h2" />)}
    </div>
  )
}

<style>
  .list { display: grid; gap: var(--space-2); max-width: calc(var(--measure) + var(--space-8)); }
</style>
