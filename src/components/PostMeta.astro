---
import { getLang, t as makeT } from '../i18n';
import { formatDate, readingTime, type Post } from '../lib/blog';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { date, updated } = post.data;
const lang = getLang(Astro.url);
const t = makeT(lang);
---

<p class="meta">
  <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
  <span aria-hidden="true">·</span>
  <span>{t('blog.readingTime', { minutes: readingTime(post.body) })}</span>
  {
    updated && (
      <>
        <span aria-hidden="true">·</span>
        <span>
          <time datetime={updated.toISOString()}>{t('blog.updatedOn', { date: formatDate(updated, lang) })}</time>
        </span>
      </>
    )
  }
</p>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    font-size: var(--font-size-label);
    color: var(--color-foreground-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
