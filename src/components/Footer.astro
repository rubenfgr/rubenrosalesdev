---
import { getLocalizedPath, type Lang, type T } from '../i18n';
import Logo from './Logo.astro';

interface Link {
  label: string;
  href: string;
}
interface Props {
  lang: Lang;
  t: T;
  tagline: string;
  motto: string;
  email: string;
  nav: Link[];
  legal: Link[];
  social: { id: string; label: string; url: string }[];
}

const { lang, t, tagline, motto, email, nav, legal, social } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="about">
      <Logo />
      <p>{tagline}</p>
    </div>
    <nav aria-label={t('footer.navigate')}>
      <ul>{nav.map((l) => <li><a href={getLocalizedPath(l.href, lang)}>{l.label}</a></li>)}</ul>
    </nav>
    <nav aria-label={t('footer.contact')}>
      <ul>
        <li><a href={`mailto:${email}`}>{email}</a></li>
        {social.map((s) => <li><a href={s.url} rel="me noopener">{s.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label={t('footer.legal')}>
      <ul>{legal.map((l) => <li><a href={getLocalizedPath(l.href, lang)}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="container meta">
    <span>{t('footer.copyright', { year })}</span>
    <span class="prompt">{t('footer.prompt', { motto })}</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: calc(var(--space-section) / 2);
    padding-block: var(--space-7);
    border-top: var(--border-width-thin) solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--font-size-label);
  }
  .footer-inner { display: grid; gap: var(--space-6); }
  .about { display: grid; gap: var(--space-3); max-width: var(--container-text); }
  .about p { color: var(--color-foreground-muted); }
  :global(main:has(> .band:last-child) + .footer) { margin-top: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  a { color: var(--color-foreground); }
  a:hover { color: var(--color-primary); }
  .meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-6); color: var(--color-foreground-muted); }
  .prompt { font-family: var(--font-family-mono); }

  @media (min-width: 40rem) {
    .footer-inner { grid-template-columns: 1fr auto auto auto; align-items: start; }
    ul { flex-direction: column; }
  }
</style>
