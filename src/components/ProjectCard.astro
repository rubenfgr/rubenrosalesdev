---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  level?: 'h2' | 'h3';
}

const { project, level: Heading = 'h3' } = Astro.props;
const { title, summary, category, context, stack, result, resultVerified } = project.data;
const contextLabel = { profesional: 'Experiencia profesional', propio: 'Proyecto propio', cliente: 'Cliente' }[context];
const categoryLabel = { automatizacion: 'Automatización', web: 'Web', movil: 'Móvil', iot: 'IoT' }[category];
---

<article class="card">
  <p class="meta">{categoryLabel} · {contextLabel}</p>
  <Heading><a href={`/proyectos/${project.id}`}>{title}</a></Heading>
  <p>{summary}</p>
  {resultVerified && result && <p class="result"><strong>Resultado:</strong> {result}</p>}
  <ul class="stack">{stack.map((s) => <li>{s}</li>)}</ul>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border-width-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .meta { font-size: var(--font-size-caption); color: var(--color-foreground-muted); }
  h2, h3 { font-size: var(--font-size-h4); font-stretch: var(--font-width-body); }
  :is(h2, h3) a { color: var(--color-foreground); text-decoration: none; }
  :is(h2, h3) a:hover { color: var(--color-primary); text-decoration: underline; }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .stack li {
    padding: var(--space-1) var(--space-2);
    font-size: var(--font-size-caption);
    background: var(--color-surface-alt);
    border-radius: var(--radius-sm);
  }
</style>
