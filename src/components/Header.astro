---
import { Menu, X } from '@lucide/astro';
import { cleanPath, getLocalizedPath, type Lang, type T } from '../i18n';
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';

interface NavItem {
  id: string;
  label: string;
  href: string;
}
interface Props {
  lang: Lang;
  t: T;
  nav: NavItem[];
  cta: string;
  role: string;
  /** Ruta de la página equivalente en cada idioma. */
  switchPaths: Record<Lang, string>;
}

const { lang, t, nav, cta, role, switchPaths } = Astro.props;

const path = cleanPath(Astro.url);
const isCurrent = (href: string) => {
  const target = getLocalizedPath(href, lang);
  return !target.includes('#') && (path === target || path.startsWith(`${target}/`));
};
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href={getLocalizedPath('/', lang)} class="brand">
      <span class="visually-hidden">{t('a11y.homeLink')}</span>
      <span class="logo-wide"><Logo /></span>
      <span class="logo-narrow"><Logo variant="symbol" /></span>
      <span class="descriptor">{role}</span>
    </a>

    <nav class="links" aria-label={t('a11y.mainNav')}>
      <ul id="menu" class="menu" data-menu>
        {
          nav.map((l) => (
            <li>
              <a href={getLocalizedPath(l.href, lang)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="cta-item"><a class="btn btn-primary" href={getLocalizedPath('/#contacto', lang)}>{cta}</a></li>
        <li class="lang-item"><LangSwitch lang={lang} t={t} paths={switchPaths} /></li>
      </ul>
    </nav>

    <div class="actions">
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls="menu"
        aria-label={t('a11y.openMenu')}
        data-label-open={t('a11y.openMenu')}
        data-label-close={t('a11y.closeMenu')}
        data-menu-btn
      >
        <span class="icon-open"><Menu size={20} stroke-width={1.5} aria-hidden="true" /></span>
        <span class="icon-close"><X size={20} stroke-width={1.5} aria-hidden="true" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (nav && btn && menu) {
    const setOpen = (open: boolean, returnFocus = false) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
      nav.toggleAttribute('data-open', open);
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else if (returnFocus) btn.focus();
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });

    // Al pasar a escritorio el menú vuelve a mostrarse en línea.
    matchMedia('(min-width: 40rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });

    const onScroll = () => nav.toggleAttribute('data-scrolled', window.scrollY > 0);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-sticky);
    height: var(--nav-height);
    padding-top: env(safe-area-inset-top);
    box-sizing: content-box;
    background: var(--color-background);
    border-bottom: var(--border-width-thin) solid transparent;
  }
  .nav[data-scrolled] { border-bottom-color: var(--color-border); }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-foreground);
  }
  .logo-narrow { display: none; }
  @media (max-width: 25.99rem) {
    .logo-wide { display: none; }
    .logo-narrow { display: inline-flex; }
  }
  .descriptor {
    display: none;
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-normal);
    color: var(--color-foreground-muted);
  }

  .links { margin-inline-start: auto; }
  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .menu a:not(.btn) {
    color: var(--color-foreground);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }
  .menu a:not(.btn):hover,
  .menu a[aria-current='page'] {
    color: var(--color-primary);
  }
  .menu a[aria-current='page']:not(.btn) {
    text-decoration: underline;
    text-decoration-thickness: var(--border-width-thick);
    text-underline-offset: var(--space-2);
  }

  .actions { display: flex; align-items: center; gap: var(--space-1); }
  .menu-btn {
    display: none;
    place-items: center;
    width: var(--space-7);
    height: var(--space-7);
    padding: 0;
    background: transparent;
    color: var(--color-foreground);
    border: 0;
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .menu-btn:hover { background: var(--color-surface-alt); }
  .icon-close { display: none; }
  .nav[data-open] .icon-open { display: none; }
  .nav[data-open] .icon-close { display: inline-flex; }

  @media (min-width: 64rem) {
    .descriptor { display: inline; }
  }

  @media (max-width: 39.99rem) {
    .menu-btn { display: inline-grid; }
    .links { position: static; margin: 0; }
    .menu {
      display: none;
      position: absolute;
      inset: calc(var(--nav-height) + env(safe-area-inset-top)) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-1);
      padding: var(--space-4) var(--container-padding) var(--space-5);
      background: var(--color-background);
      border-bottom: var(--border-width-thin) solid var(--color-border);
    }
    .nav[data-open] .menu { display: flex; }
    .menu a:not(.btn) { display: block; padding: var(--space-3) 0; }
    .cta-item { margin-top: var(--space-3); }
    .lang-item { margin-top: var(--space-2); }
    .cta-item .btn { justify-content: center; width: 100%; }
  }
</style>
