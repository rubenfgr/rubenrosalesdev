---
interface Props {
  /** `light`: sobre fondo claro. `dark`: sobre fondo oscuro (footer). */
  tone?: 'light' | 'dark';
  size?: number;
  label?: string;
}

const { tone = 'light', size = 26, label } = Astro.props;
---

<svg
  viewBox="0 0 84 84"
  width={size}
  height={size}
  class:list={['logo', tone]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g class="wall">
    <rect x="0" y="6" width="22" height="23"></rect>
    <rect x="26" y="6" width="26" height="23"></rect>
    <rect x="0" y="33" width="36" height="23"></rect>
    <rect x="40" y="33" width="38" height="23"></rect>
    <rect x="0" y="60" width="18" height="24"></rect>
    <rect x="22" y="60" width="38" height="24"></rect>
    <rect x="64" y="60" width="14" height="24"></rect>
  </g>
  <rect class="piece" x="62" y="0" width="22" height="23"></rect>
</svg>

<style>
  .logo { display: block; flex-shrink: 0; }
  .wall { fill: var(--color-foreground); }
  .piece { fill: var(--color-primary); }
  .dark .wall { fill: var(--color-dark-text); }
  .dark .piece { fill: var(--color-primary-on-dark-strong); }
</style>
