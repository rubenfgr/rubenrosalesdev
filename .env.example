# Secretos para desarrollo local (copiar a .dev.vars, que no se versiona)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
CONTACT_TO=
# Proveedor de envío: gmail (por defecto) o resend
CONTACT_PROVIDER=
RESEND_API_KEY=
CONTACT_FROM=
# Asistente con LLM (desactivado por defecto; activar con ASSISTANT_LLM_ENABLED=1)
ASSISTANT_LLM_ENABLED=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=
