    "content:new": "node scripts/content-new.mjs",
    "content:list": "node scripts/content-list.mjs",
    "dev:tailscale": "astro dev --host",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/node": "^11.1.9",
    "@astrojs/preact": "^6.1.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/astro": "^1.61.0",
    "@rr/shared": "workspace:*",
    "astro": "^7.4.2",
    "astro-expressive-code": "0.44.3",
    "preact": "^11.0.2",
    "remark-directive": "4.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
