{
  "name": "@rr/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-redirects.mjs && astro build && node scripts/check-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "build:prod": "GUARDS_STRICT=1 pnpm build",
    "i18n:check": "node scripts/i18n-check.mjs",
