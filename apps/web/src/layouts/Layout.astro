---
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Scroll from '../components/Scroll.astro';
import Assistant from '../components/islands/Assistant';
import { getData } from '../i18n/content';
import { cleanPath, getAlternates, getLang, getLocalizedPath, intlLocale, locales, t as makeT, ui, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Ruta equivalente por idioma cuando no es la misma (p. ej. un artículo con otro slug). Solo idiomas que existen. */
  paths?: Partial<Record<Lang, string>>;
}

const { title, description, noindex = false, ogType = 'website', paths } = Astro.props;
const lang = getLang(Astro.url);
const t = makeT(lang);
const site = await getData('site', lang);
const assistant = await getData('assistant', lang);
const siteUrl = Astro.site ?? new URL('https://rubenrosales.dev');

const fullTitle = title ? `${title} · ${site.name}` : site.seo.title;
const metaDescription = description ?? site.seo.description;
// El asistente está construido pero oculto hasta que se decida implementarlo: PUBLIC_ASSISTANT_ENABLED=1 lo muestra.
const assistantEnabled = import.meta.env.PUBLIC_ASSISTANT_ENABLED === '1';
// Texto libre al LLM (API); sin esto el asistente solo usa el motor de reglas.
const assistantLlm = import.meta.env.PUBLIC_ASSISTANT_LLM === '1';
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const canonical = new URL(cleanPath(Astro.url), siteUrl).href;
const ogImage = new URL(`/og-${lang}.png`, siteUrl).href;
const alternates = getAlternates(Astro.url, siteUrl, paths);
const currentPath = cleanPath(Astro.url).replace(/^\/en(?=\/|$)/, '') || '/';
const switchPaths = Object.fromEntries(locales.map((l) => [l, paths ? (paths[l] ?? '/') : currentPath])) as Record<Lang, string>;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={intlLocale[a.lang]} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === 'es')?.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={t('meta.rssTitle')} href={getLocalizedPath('/rss.xml', lang)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={t('meta.ogLocale')} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={intlLocale[a.lang].replace('-', '_')} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t('a11y.skipToContent')}</a>
    <Header lang={lang} t={t} name={site.name} nav={site.nav} cta={site.cta} email={site.contact.email} role={site.role} switchPaths={switchPaths} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} t={t} name={site.name} tagline={site.footer.tagline} motto={site.footer.motto} email={site.contact.email} nav={site.nav} legal={site.legal} social={site.social} />
    {assistantEnabled && <Assistant client:idle data={assistant} labels={ui(lang, 'assistant')} lang={lang} privacyHref="/privacidad" llm={assistantLlm} />}
    <Scroll />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>
