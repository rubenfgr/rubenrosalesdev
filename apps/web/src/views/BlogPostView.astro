---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import PostMeta from '../components/PostMeta.astro';
import RecentPosts from '../components/RecentPosts.astro';
import TagList from '../components/TagList.astro';
import TOC from '../components/TOC.astro';
import { getData } from '../i18n/content';
import { t as makeT, type Lang } from '../i18n';
import Layout from '../layouts/Layout.astro';
import { postLang, postUrl, type Post } from '../lib/blog';
import '../styles/prose.css';

interface Props {
  post: Post;
  older?: Post | undefined;
  newer?: Post | undefined;
  recent: Post[];
  /** Ruta equivalente por idioma (según `translationKey`). */
  paths: Partial<Record<Lang, string>>;
}

const { post, older, newer, recent, paths } = Astro.props;
const lang = postLang(post);
const t = makeT(lang);
const site = await getData('site', lang);
const { Content, headings } = await render(post);
const editUrl = `${site.social.find((s) => s.id === 'github')?.url}/rubenrosalesdev/edit/main/src/content/blog/${post.id}.mdx`;
---

<Layout title={post.data.title} description={post.data.description} ogType="article" paths={paths}>
  <div class="container shell">
    <div class="toc-mobile"><TOC headings={headings} variant="details" /></div>

    <article class="article">
      <header class="head">
        <h1>{post.data.title}</h1>
        <PostMeta post={post} />
        <TagList tags={post.data.tags} />
      </header>

      {
        post.data.cover && (
          <Image class="cover" src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 42rem, 100vw" />
        )
      }

      <div class="prose"><Content /></div>

      <nav class="adjacent" aria-label={t('blog.adjacentLabel')}>
        {older ? <a href={postUrl(older)} rel="prev"><span>{t('blog.previous')}</span>{older.data.title}</a> : <span />}
        {newer ? <a href={postUrl(newer)} rel="next"><span>{t('blog.next')}</span>{newer.data.title}</a> : <span />}
      </nav>
      <p class="edit"><a href={editUrl} rel="noopener">{t('blog.editOnGithub')}</a></p>
    </article>

    <aside class="toc-aside" aria-label={t('blog.tocLabel')}><TOC headings={headings} variant="aside" /></aside>
    <aside class="recent"><RecentPosts posts={recent} currentId={post.id} /></aside>
  </div>
</Layout>

<style>
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-7);
    grid-template-areas: 'toc' 'article' 'recent';
  }
  .toc-mobile { grid-area: toc; }
  .toc-aside { display: none; grid-area: tocside; }
  .article { grid-area: article; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); align-content: start; }
  .recent { grid-area: recent; }
  .head { display: grid; gap: var(--space-3); }
  .cover { width: 100%; height: auto; border-radius: var(--radius-lg); }
  .adjacent { display: grid; gap: var(--space-4); margin-top: var(--space-6); padding-top: var(--space-5); border-top: var(--border-width-thin) solid var(--color-border); }
  .adjacent a { display: grid; gap: var(--space-1); text-decoration: none; color: var(--color-foreground); }
  .adjacent a:hover { color: var(--color-primary); }
  .adjacent span { font-size: var(--font-size-label); color: var(--color-foreground-muted); }
  .edit { font-size: var(--font-size-label); }

  @media (min-width: 40rem) {
    .shell {
      grid-template-columns: minmax(0, 1fr) 15rem;
      grid-template-areas: 'article tocside' 'recent recent';
      align-items: start;
    }
    .toc-mobile { display: none; }
    .toc-aside { display: block; position: sticky; top: calc(var(--nav-height) + var(--space-5)); }
    .adjacent { grid-template-columns: 1fr 1fr; }
    .adjacent a:last-child { text-align: end; }
  }
  @media (min-width: 64rem) {
    .shell {
      grid-template-columns: 14rem minmax(0, 1fr) 15rem;
      grid-template-areas: 'recent article tocside';
    }
    .recent { position: sticky; top: calc(var(--nav-height) + var(--space-5)); }
  }
</style>
