---
// Vista de la home, común a «/» y «/en». Todo el texto sale de las colecciones y de src/i18n/ui.
import Proceso from '../components/Proceso.astro';
import Calculadora from '../components/islands/Calculadora';
import ComoFunciona from '../components/islands/ComoFunciona';
import Contacto from '../components/islands/Contacto';
import FAQ from '../components/islands/FAQ';
import Hero from '../components/islands/Hero';
import Integraciones from '../components/islands/Integraciones';
import Problema from '../components/islands/Problema';
import Proyectos from '../components/islands/Proyectos';
import Servicios from '../components/islands/Servicios';
import { getData } from '../i18n/content';
import { getLang, getLocalizedPath, intlLocale, t as makeT, ui } from '../i18n';
import Layout from '../layouts/Layout.astro';

const lang = getLang(Astro.url);
const t = makeT(lang);
const locale = intlLocale[lang];
const [services, problem, tray, process, projects, faq, integrations, site] = await Promise.all([
  getData('services', lang),
  getData('problemTasks', lang),
  getData('trayItems', lang),
  getData('process', lang),
  getData('projects', lang),
  getData('faq', lang),
  getData('integrationCases', lang),
  getData('site', lang),
]);
const visibleProjects = projects.items.filter((p) => import.meta.env.DEV || !p.draft);
const contactHref = getLocalizedPath('/#contacto', lang);
const projectsHref = getLocalizedPath('/#proyectos', lang);
const hero = ui(lang, 'hero');
---

<Layout>
  <Hero
    client:visible
    headline={hero.headline.a}
    lead={hero.lead}
    leadStrong={hero.leadStrong}
    ctaPrimary={hero.ctaPrimary}
    ctaSecondary={hero.ctaSecondary}
    contactHref={contactHref}
    projectsHref={projectsHref}
    pillars={hero.pillars}
    stats={hero.stats}
  />
  <Integraciones client:visible cases={integrations.items} labels={ui(lang, 'integrations')} approvedLabel={t('integrations.hubApproved')} waitLabel={t('integrations.hubWaiting')} />
  <Problema client:visible tasks={problem.items} labels={ui(lang, 'problem')} locale={locale} />
  <Servicios client:visible services={services.items} labels={ui(lang, 'services')} locale={locale} contactHref={contactHref} />
  <ComoFunciona client:visible items={tray.items} modes={tray.modes} log={tray.log} labels={ui(lang, 'tray')} />
  <Calculadora client:visible labels={ui(lang, 'calculator')} locale={locale} contactHref={contactHref} />
  <Proceso eyebrow={t('process.eyebrow')} title1={t('process.title1')} title2={t('process.title2')} steps={process.items} />
  <Proyectos client:visible projects={visibleProjects} labels={ui(lang, 'projects')} locale={locale} contactHref={contactHref} />
  <FAQ client:visible items={faq.items} labels={ui(lang, 'faq')} contactHref={contactHref} />
  <Contacto client:visible labels={ui(lang, 'contact')} lang={lang} email={site.contact.email} endpoint="/api/contact" />
</Layout>
