---
import { getLang, getLocalizedPath, t as makeT } from '../i18n';
import Layout from '../layouts/Layout.astro';

const lang = getLang(Astro.url);
const t = makeT(lang);
---

<Layout title={t('meta.notFoundTitle')} noindex>
  <div class="container wrap">
    <h1>{t('notFound.title')}</h1>
    <p>{t('notFound.text')}</p>
    <p class="ctas">
      <a class="btn btn-primary" href={getLocalizedPath('/', lang)}>{t('notFound.home')}</a>
      <a class="btn btn-secondary" href={getLocalizedPath('/blog', lang)}>{t('notFound.blog')}</a>
    </p>
  </div>
</Layout>

<style>
  .wrap { padding-top: var(--space-9); display: grid; gap: var(--space-4); justify-items: start; }
  .ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; }
</style>
