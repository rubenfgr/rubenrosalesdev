---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getProjects } from '../../lib/projects';
import '../../styles/prose.css';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, stack, context, result, resultVerified } = project.data;
const contextLabel = { profesional: 'Experiencia profesional', propio: 'Proyecto propio', cliente: 'Cliente' }[context];
---

<Layout title={title} description={summary}>
  <article class="container wrap">
    <p class="back"><a href="/#proyectos">← Proyectos</a></p>
    <header class="head">
      <p class="meta">{contextLabel}</p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      {resultVerified && result && <p><strong>Resultado:</strong> {result}</p>}
      <ul class="stack">{stack.map((s) => <li>{s}</li>)}</ul>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Layout>

<style>
  .wrap { padding-top: var(--space-7); padding-bottom: var(--space-section); display: grid; gap: var(--space-6); }
  .back { padding-bottom: var(--space-3); }
  .head { display: grid; gap: var(--space-4); align-content: start; padding-top: var(--space-3); border-top: var(--border-width-thick) solid var(--color-rule); }
  .head h1 { font-size: var(--font-size-display); font-weight: var(--font-weight-heavy); letter-spacing: var(--letter-spacing-tighter); line-height: 1; }
  .meta { font-family: var(--font-family-mono); font-size: var(--font-size-mono); letter-spacing: var(--letter-spacing-label); color: var(--color-foreground-muted); }
  .lead { font-size: var(--font-size-lead); color: var(--color-foreground-muted); }
  .stack { list-style: none; margin: 0; padding: var(--space-3) 0 0; border-top: var(--border-width-thin) solid var(--color-border-strong); display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  .stack li { font-family: var(--font-family-mono); font-size: var(--font-size-mono); letter-spacing: var(--letter-spacing-label); }
  .prose { border-top: var(--border-width-thick) solid var(--color-rule); padding-top: var(--space-3); }
  @media (min-width: 64rem) {
    .wrap { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--space-8); align-items: start; }
    .back { grid-column: 1 / -1; }
    .head { position: sticky; top: calc(var(--nav-height) + var(--space-5)); }
  }
</style>
