---
import { getLang, getLocalizedPath, t as makeT } from '../i18n';

interface Props {
  tags: readonly string[];
}
const { tags } = Astro.props;
const lang = getLang(Astro.url);
const t = makeT(lang);
---

<ul class="tags" aria-label={t('blog.tags')}>
  {tags.map((tag) => <li><a href={getLocalizedPath(`/blog/etiquetas/${tag}`, lang)}>{tag}</a></li>)}
</ul>

<style>
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-mono);
    letter-spacing: var(--letter-spacing-label);
    color: var(--color-foreground-muted);
    text-decoration: none;
  }
  a::before { content: '#'; color: var(--color-foreground-muted); margin-inline-end: 2px; }
  a:hover { color: var(--color-primary); text-decoration: underline; text-underline-offset: 4px; }
</style>
