---
import { getLocalizedPath, type Lang, type T } from '../i18n';
import Logo from './Logo.astro';

interface Link {
  label: string;
  href: string;
}
interface Props {
  lang: Lang;
  t: T;
  name: string;
  tagline: string;
  motto: string;
  email: string;
  nav: Link[];
  legal: Link[];
  social: { id: string; label: string; url: string }[];
}

const { lang, t, name, tagline, motto, email, nav, legal, social } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="hilada footer-hilada" aria-hidden="true"></div>
  <div class="inner">
    <div class="grid">
      <div class="about">
        <div class="brand"><Logo tone="dark" size={30} /><span class="name">{name}</span></div>
        <p>{tagline}</p>
      </div>
      <nav class="col" aria-label={t('footer.navigate')}>
        <span class="label">{t('footer.navigate')}</span>
        {nav.map((l) => <a href={getLocalizedPath(l.href, lang)}>{l.label}</a>)}
      </nav>
      <div class="col">
        <span class="label">{t('footer.contact')}</span>
        <a href={`mailto:${email}`}>{email}</a>
        {social.map((s) => <a href={s.url} rel="me noopener" target="_blank">{s.label}</a>)}
      </div>
      <nav class="col" aria-label={t('footer.legal')}>
        <span class="label">{t('footer.legal')}</span>
        {legal.map((l) => <a href={getLocalizedPath(l.href, lang)}>{l.label}</a>)}
      </nav>
    </div>
    <div class="meta">
      <span>{t('footer.copyright', { year })}</span>
      <span class="prompt">{t('footer.prompt', { motto })}</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-dark-footer); color: var(--color-dark-text-muted); }
  .footer-hilada { --hilada-height: 4.5rem; --hilada-color: var(--color-dark-border); }
  .inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-7) var(--container-padding) var(--space-6);
  }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  /* 640–1023 px: la marca ocupa una fila y Navegar, Contacto y Legal van en tres columnas; desde 1024 px, cuatro columnas. */
  @media (min-width: 40rem) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .about { grid-column: 1 / -1; } }
  @media (min-width: 64rem) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } .about { grid-column: auto; } }
  .brand { display: flex; align-items: center; gap: var(--space-3); }
  .name { font-size: var(--font-size-h4); font-weight: var(--font-weight-heavy); letter-spacing: var(--letter-spacing-tight); color: var(--color-dark-text); }
  .about p { font-size: var(--font-size-label); line-height: 1.55; margin: 10px 0 0; max-width: 260px; }
  .col { display: flex; flex-direction: column; gap: 0; font-size: var(--font-size-label); }
  .label { font-family: var(--font-family-mono); font-size: var(--font-size-mono); color: var(--color-dark-text-faint); letter-spacing: var(--letter-spacing-label); }
  .col { gap: 0; }
  .label { margin-bottom: var(--space-2); }
  .col a { color: var(--color-dark-text-muted); display: flex; align-items: center; min-height: var(--target-min); }
  .col a:hover { color: var(--color-primary-foreground); }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: 56px;
    padding-top: var(--space-5);
    border-top: var(--border-width-thick) solid var(--color-dark-border-strong);
    font-size: var(--font-size-small);
  }
  .prompt { font-family: var(--font-family-mono); font-size: var(--font-size-caption); color: var(--color-dark-text-faint); }
</style>
