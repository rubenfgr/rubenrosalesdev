---
import { postUrl, type Post } from '../lib/blog';
import PostMeta from './PostMeta.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  featured?: boolean;
  level?: 'h2' | 'h3';
}
const { post, featured = false, level = 'h3' } = Astro.props;
const Heading = featured ? 'h2' : level;
---

<article class:list={['card', { featured }]}>
  <PostMeta post={post} />
  <Heading><a href={postUrl(post)}>{post.data.title}</a></Heading>
  <p class="desc">{post.data.description}</p>
  <TagList tags={post.data.tags} />
</article>

<style>
  .card {
    display: grid; gap: var(--space-2) var(--space-6); padding-block: var(--space-5);
    border-top: var(--border-width-thick) solid var(--color-rule);
    grid-template-columns: minmax(0, 1fr);
  }
  .card :global(.meta) { font-family: var(--font-family-mono); font-size: var(--font-size-mono); letter-spacing: var(--letter-spacing-label); }
  h2, h3 { font-size: var(--font-size-h3); font-stretch: var(--font-width-body); font-weight: var(--font-weight-heavy); letter-spacing: var(--letter-spacing-tight); line-height: 1.1; }
  .featured h2 { font-size: var(--font-size-h2); font-stretch: var(--font-width-display); letter-spacing: var(--letter-spacing-display); }
  h2 a, h3 a { color: var(--color-foreground); text-decoration: none; }
  h2 a:hover, h3 a:hover { color: var(--color-primary); text-decoration: underline; text-decoration-thickness: var(--border-width-thick); text-underline-offset: 6px; }
  .desc { color: var(--color-foreground-muted); max-width: var(--measure); }
  @media (min-width: 64rem) {
    .card { grid-template-columns: 11rem minmax(0, 1fr); }
    .card > :global(.meta) { grid-row: 1 / span 3; align-self: start; flex-direction: column; padding-top: 0.5em; }
    .card > :global(.meta span[aria-hidden]) { display: none; }
    .card > :not(:global(.meta)) { grid-column: 2; }
  }
</style>
