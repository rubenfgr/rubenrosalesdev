---
import { getLang, getLocalizedPath, t as makeT } from '../i18n';
import { POSTS_PER_PAGE, tagCounts, type Post } from '../lib/blog';
import BlogBrowser from './islands/BlogBrowser';
import BlogList from './BlogList.astro';
import Pagination from './Pagination.astro';
import Section from './Section.astro';

interface Props {
  posts: Post[];
  page: number;
}
const { posts, page } = Astro.props;
const lang = getLang(Astro.url);
const t = makeT(lang);
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const slice = posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
const labels = {
  search: t('blog.search'), searchPlaceholder: t('blog.searchPlaceholder'), clearSearch: t('blog.clearSearch'), filterTags: t('blog.filterTags'), clearFilters: t('blog.clearFilters'),
  resultsOne: t('blog.resultsOne'), resultsMany: t('blog.resultsMany'), noResults: t('blog.noResults'), noResultsHint: t('blog.noResultsHint'),
  searchLoading: t('blog.searchLoading'), searchError: t('blog.searchError'), pageN: t('blog.pageN'), readingTime: t('blog.readingTime'),
  tagsAria: t('blog.tags'), pagination: t('blog.pagination'), newer: t('blog.newer'), older: t('blog.older'),
};
---

<Section as="h1" id="blog" title={t('blog.title')} lead={t('blog.description')}>
  {
    posts.length > 0 && (
      <BlogBrowser client:only="preact" tags={tagCounts(posts)} perPage={POSTS_PER_PAGE} indexUrl={getLocalizedPath('/blog/search.json', lang)} tagBase={getLocalizedPath('/blog/etiquetas/', lang)} staticId="blog-static" labels={labels} />
    )
  }
  <div id="blog-static">
    <BlogList posts={slice} featuredFirst={page === 1} />
    <Pagination page={page} totalPages={totalPages} />
  </div>
  <p class="links"><a href={getLocalizedPath('/blog/etiquetas', lang)}>{t('blog.tagsIndex')}</a> · <a href={getLocalizedPath('/blog/archivo', lang)}>{t('blog.archive')}</a> · <a href={getLocalizedPath('/rss.xml', lang)}>{t('blog.rss')}</a></p>
</Section>

<style>
  .links { margin-top: var(--space-6); }
</style>
