---
// Motivo «hilada» (src/assets/motifs/hilada.svg) como fondo con desplazamiento lento.
---

<div class="motif" aria-hidden="true">
  <svg class="track" width="100%" height="100%" fill="none" stroke="currentColor">
    <defs>
      <pattern id="hilada" width="240" height="96" patternUnits="userSpaceOnUse">
        <path d="M0 0.5H240M0 32.5H240M0 64.5H240" />
        <path d="M38.5 0V32.5M101.5 0V32.5M178.5 0V32.5" />
        <path d="M14.5 32.5V64.5M72.5 32.5V64.5M139.5 32.5V64.5M209.5 32.5V64.5" />
        <path d="M50.5 64.5V96M117.5 64.5V96M190.5 64.5V96" />
      </pattern>
    </defs>
    <rect x="-240" width="calc(100% + 480px)" height="100%" fill="url(#hilada)" />
  </svg>
</div>

<style>
  .motif {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--color-border);
    opacity: 0.6;
    pointer-events: none;
    z-index: var(--z-base);
  }
  .track {
    animation: drift var(--duration-ambient) linear infinite;
  }
  @keyframes drift {
    to { transform: translateX(15rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }
</style>
