---
// Barra de progreso, anclas con el offset del header y reveal de apertura de sección (regla + titular, una vez).
// Todo se desactiva con prefers-reduced-motion.
---

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const OFFSET = -68;
  const progress = document.querySelector<HTMLElement>('[data-progress]');

  const updateProgress = () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
  };
  updateProgress();
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);

  // Anclas de la misma página: scroll con el offset del header (suave solo si el usuario no pide menos movimiento).
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!a || a.target === '_blank' || e.defaultPrevented || e.metaKey || e.ctrlKey) return;
    const url = new URL(a.href, location.href);
    const clean = (p: string) => p.replace(/\/$/, '') || '/';
    if (url.origin !== location.origin || clean(url.pathname) !== clean(location.pathname) || !url.hash) return;
    const target = document.querySelector(url.hash);
    if (!target) return;
    e.preventDefault();
    history.pushState(null, '', url.hash);
    scrollTo({ top: target.getBoundingClientRect().top + scrollY + OFFSET, behavior: reduced ? 'auto' : 'smooth' });
  });

  // Reveal: al entrar la sección en el viewport se dibuja la regla y sube el titular. Una sola vez.
  if (!reduced && 'IntersectionObserver' in window) {
    const groups = document.querySelectorAll<HTMLElement>('[data-reveal]');
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          en.target.classList.add('is-revealed');
          io.unobserve(en.target);
        }),
      { threshold: 0.05 },
    );
    groups.forEach((g) => {
      // Lo que ya está dentro del viewport al cargar no se anima: no hay que esconderlo y volver a mostrarlo.
      if (g.getBoundingClientRect().top < innerHeight) g.classList.add('is-revealed');
      else io.observe(g);
    });
  }
</script>
