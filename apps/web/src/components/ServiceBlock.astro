---
import { LayoutDashboard, Smartphone, Workflow } from '@lucide/astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  detailed?: boolean;
  level?: 'h2' | 'h3';
}

const { service, detailed = false, level: Heading = 'h3' } = Astro.props;
const Icon = { workflow: Workflow, 'layout-dashboard': LayoutDashboard, smartphone: Smartphone }[service.icon];
---

<article class="service">
  <span class="icon" aria-hidden="true"><Icon size={24} stroke-width={1.5} /></span>
  <Heading>{service.title}</Heading>
  <p>{service.summary}</p>
  <ul>{service.points.map((p) => <li>{p}</li>)}</ul>
  {
    detailed && (
      <dl>
        <dt>Para quién es</dt>
        <dd>{service.forWhom}</dd>
        <dt>Qué recibes</dt>
        <dd>{service.receive}</dd>
        <dt>Cuándo no lo recomiendo</dt>
        <dd>{service.notRecommended}</dd>
      </dl>
    )
  }
</article>

<style>
  .service {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border-width-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .service:hover { border-color: var(--color-primary); box-shadow: var(--shadow-md); }
  .icon {
    display: grid;
    place-items: center;
    width: var(--space-7);
    height: var(--space-7);
    color: var(--color-primary);
    background: var(--color-info-surface);
    border-radius: var(--radius-md);
  }
  h2, h3 { font-size: var(--font-size-h4); font-stretch: var(--font-width-body); letter-spacing: 0; }
  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-2); }
  li { position: relative; padding-inline-start: var(--space-5); }
  li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.7em;
    width: var(--space-3);
    height: var(--border-width-thick);
    background: var(--color-accent);
  }
  dl { margin: 0; display: grid; gap: var(--space-1); padding-top: var(--space-4); border-top: var(--border-width-thin) solid var(--color-border); }
  dt { font-weight: var(--font-weight-medium); margin-top: var(--space-3); }
  dd { margin: 0; color: var(--color-foreground-muted); }
</style>
