---
// Traza de una ejecución: cada paso es una barra con su inicio y su duración relativos (ilustrativo, sin tiempos reales).
import Figure from './Figure.astro';
interface Row { label: string; start: number; width: number; tone: 'model' | 'code' | 'data' | 'person'; note?: string }
interface Props { rows: Row[]; caption?: string; legend?: { tone: Row['tone']; label: string }[]; axis?: string }
const { rows, caption, legend, axis } = Astro.props;
---

<Figure caption={caption}>
  <ol class="wf">
    {rows.map((r) => (
      <li class={`row tone-${r.tone}`}>
        <span class="lab">{r.label}{r.note && <small>{r.note}</small>}</span>
        <span class="track"><i style={`left:${r.start}%;width:${r.width}%`}></i></span>
      </li>
    ))}
  </ol>
  {axis && <p class="axis" aria-hidden="true"><span>0</span><span>{axis}</span></p>}
  {legend && (
    <ul class="legend">
      {legend.map((l) => <li class={`tone-${l.tone}`}><i></i>{l.label}</li>)}
    </ul>
  )}
</Figure>

<style>
  .wf, .legend { list-style: none; margin: 0; padding: 0; }
  .wf { display: grid; gap: var(--space-2); padding: var(--space-4); background: var(--color-surface); border: var(--border-width-thin) solid var(--color-border); border-radius: var(--radius-md); }
  .row { display: grid; gap: var(--space-1); }
  .lab { font-size: var(--font-size-label); line-height: var(--line-height-snug); }
  .lab small { display: block; font-size: var(--font-size-small); color: var(--color-foreground-muted); }
  .track { position: relative; block-size: var(--space-4); background: var(--color-surface-sunken); border-radius: var(--radius-sm); }
  .track i { position: absolute; top: 0; bottom: 0; background: var(--t-bg); border: var(--border-width-thin) solid var(--t-bd); border-radius: var(--radius-sm); }
  .axis { display: flex; justify-content: space-between; margin: var(--space-2) 0 0; font-family: var(--font-family-mono); font-size: var(--font-size-mono); color: var(--color-foreground-subtle); }
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: var(--space-3); font-size: var(--font-size-small); color: var(--color-foreground-muted); }
  .legend li { display: flex; align-items: center; gap: var(--space-2); }
  .legend i { inline-size: var(--space-4); block-size: var(--space-3); border-radius: var(--radius-sm); background: var(--t-bg); border: var(--border-width-thin) solid var(--t-bd); }
  @container (min-width: 36rem) { .row { grid-template-columns: 11rem minmax(0, 1fr); align-items: center; gap: var(--space-3); } }
</style>
