---
// Herramientas habituales por capa. Las que se usan en el proyecto van en negrita y marcadas (`used`).
import Figure from './Figure.astro';
interface Tool { name: string; used?: boolean }
interface Kind { label: string; tools: Tool[] }
interface Row { n: number; layer: string; kinds: Kind[] }
interface Props { rows: Row[]; usedLabel: string; legend: string }
const { rows, usedLabel, legend } = Astro.props;
---

<Figure caption={legend}>
  <ol class="rows">
    {rows.map((r) => (
      <li class="row">
        <h4><em>{r.n}</em>{r.layer}</h4>
        <dl>
          {r.kinds.map((k) => (
            <div class="kind">
              <dt>{k.label}</dt>
              <dd>
                <ul>
                  {k.tools.map((t) => (
                    <li class={t.used ? 'chip used' : 'chip'}>
                      {t.used ? <strong>{t.name}<span class="sr"> ({usedLabel})</span></strong> : t.name}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ol>
</Figure>

<style>
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .row { padding: var(--space-4); background: var(--color-surface); border: var(--border-width-thin) solid var(--color-border); border-radius: var(--radius-md); }
  h4 { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-3); font-size: var(--font-size-body); font-weight: var(--font-weight-strong); }
  h4 em { display: inline-grid; place-items: center; inline-size: var(--space-5); block-size: var(--space-5); border-radius: var(--radius-full); background: var(--color-tint-sea); border: var(--border-width-thin) solid var(--color-primary-light); font-style: normal; font-size: var(--font-size-small); }
  dl { margin: 0; display: grid; gap: var(--space-2); }
  .kind { display: grid; gap: var(--space-1); }
  dt { font-family: var(--font-family-mono); font-size: var(--font-size-mono); letter-spacing: var(--letter-spacing-label); text-transform: uppercase; color: var(--color-foreground-muted); }
  dd { margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip { padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); background: var(--color-surface-sunken); border: var(--border-width-thin) solid var(--color-border); font-size: var(--font-size-label); color: var(--color-foreground-muted); }
  .chip.used { background: var(--color-tint-sea); border-color: var(--color-primary); color: var(--color-foreground); }
  .chip.used strong { font-weight: var(--font-weight-heavy); }
  .chip.used::before { content: '●'; margin-inline-end: var(--space-1); font-size: var(--font-size-mono); color: var(--color-primary); vertical-align: 0.1em; }
  .sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @container (min-width: 36rem) { .kind { grid-template-columns: 9.5rem minmax(0, 1fr); align-items: baseline; gap: var(--space-3); } }
</style>
