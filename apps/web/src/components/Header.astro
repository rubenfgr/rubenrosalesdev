---
import { cleanPath, getLocalizedPath, ui, type Lang, type T } from '../i18n';
import LangSwitch from './LangSwitch.astro';
import Logo from './Logo.astro';
import MobileMenu from './islands/MobileMenu';

interface NavItem {
  id: string;
  label: string;
  href: string;
}
interface Props {
  lang: Lang;
  t: T;
  name: string;
  nav: NavItem[];
  cta: { short: string; long: string };
  email: string;
  role: string;
  /** Ruta de la página equivalente en cada idioma. */
  switchPaths: Record<Lang, string>;
}

const { lang, t, name, nav, cta, email, role, switchPaths } = Astro.props;
const path = cleanPath(Astro.url);
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(getLocalizedPath(href, lang));
const items = nav.map((n) => ({ ...n, href: getLocalizedPath(n.href, lang) }));
const contactHref = getLocalizedPath('/#contacto', lang);
---

<header class="header" data-header data-solid={path.includes('/blog') ? '' : undefined}>
  <div class="bar">
    <a class="brand" href={getLocalizedPath('/', lang)} aria-label={t('a11y.homeLink')}>
      <Logo size={26} />
      <span class="brand-text">{name} <span class="sep">|</span> <span class="role">{role}</span></span>
    </a>

    <nav class="desktop" aria-label={t('a11y.mainNav')}>
      {items.map((l) => <a class="link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <span class="divider" aria-hidden="true"></span>
      <LangSwitch lang={lang} t={t} paths={switchPaths} />
      <a class="cta" href={contactHref}>{cta.short} <span class="mono-arrow arrow">→</span></a>
    </nav>

    <div class="mobile">
      <MobileMenu
        client:idle
        items={items}
        cta={cta.long}
        contactHref={contactHref}
        email={email}
        labels={ui(lang, 'a11y')}
        switchHref={getLocalizedPath(switchPaths[lang === 'es' ? 'en' : 'es'], lang === 'es' ? 'en' : 'es')}
        switchLabel={t(`lang.${lang === 'es' ? 'en' : 'es'}`)}
        switchCode={(lang === 'es' ? 'en' : 'es').toUpperCase()}
        switchAria={t('lang.switchTo', { lang: t(`lang.${lang === 'es' ? 'en' : 'es'}`) })}
        otherLang={lang === 'es' ? 'en' : 'es'}
      />
    </div>
  </div>
  <div class="progress" aria-hidden="true"><div class="progress-bar" data-progress></div></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-sticky);
    background: rgb(244 245 242 / 0.78);
    backdrop-filter: blur(16px) saturate(140%);
    border-bottom: var(--border-width-thin) solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }
  .header[data-scrolled],
  .header[data-solid] { border-bottom-color: var(--color-border); }
  .bar {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--color-foreground); min-width: 0; }
  .brand:hover { color: var(--color-foreground); }
  .brand-text { font-size: 15px; font-weight: var(--font-weight-bold); letter-spacing: -0.01em; white-space: nowrap; }
  .sep { color: var(--color-primary); font-weight: var(--font-weight-regular); }
  .role { color: var(--color-foreground-muted); font-weight: var(--font-weight-medium); }
  .desktop { display: none; align-items: center; gap: var(--space-1); }
  .link {
    color: var(--color-foreground);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    transition: all var(--duration-base) var(--ease-out);
  }
  .link:hover, .link[aria-current='page'] { background: var(--color-surface-alt); color: var(--color-primary); }
  .divider { width: 1px; height: 20px; background: var(--color-border); margin-inline: 10px; }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-inline-start: var(--space-2);
    background: var(--color-foreground);
    color: var(--color-primary-foreground);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    padding: 10px var(--space-4);
    border-radius: var(--radius-md);
    transition: background var(--duration-base) var(--ease-out);
  }
  .cta:hover { background: var(--gradient-brand); color: var(--color-primary-foreground); }
  .arrow { font-size: 12px; opacity: 0.7; }
  .progress { position: absolute; inset: auto 0 -1px 0; height: 2px; pointer-events: none; }
  .progress-bar { height: 100%; background: var(--gradient-brand); transform-origin: 0 50%; transform: scaleX(0); }

  .link, .cta { white-space: nowrap; }
  .role, .sep { display: none; }
  @media (min-width: 75rem) {
    .desktop { display: flex; }
    .mobile { display: none; }
  }
  @media (min-width: 82rem) {
    .role, .sep { display: inline; }
  }
</style>
