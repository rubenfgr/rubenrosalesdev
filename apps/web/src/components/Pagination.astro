---
import { getLang, t as makeT } from '../i18n';
import { pageUrl } from '../lib/blog';

interface Props {
  page: number;
  totalPages: number;
}
const { page, totalPages } = Astro.props;
const lang = getLang(Astro.url);
const t = makeT(lang);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label={t('blog.pagination')}>
      {page > 1 ? <a href={pageUrl(page - 1, lang)} rel="prev">{t('blog.newer')}</a> : <span aria-hidden="true" />}
      <ul>
        {pages.map((n) => <li><a href={pageUrl(n, lang)} aria-current={n === page ? 'page' : undefined}>{n}</a></li>)}
      </ul>
      {page < totalPages ? <a href={pageUrl(page + 1, lang)} rel="next">{t('blog.older')}</a> : <span aria-hidden="true" />}
    </nav>
  )
}

<style>
  .pagination { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-6); flex-wrap: wrap; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-2); }
  ul a {
    display: inline-grid;
    place-items: center;
    min-width: var(--space-6);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  ul a[aria-current='page'] { background: var(--color-primary); color: var(--color-primary-foreground); }
</style>
