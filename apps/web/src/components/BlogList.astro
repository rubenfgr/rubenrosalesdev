---
import { getLang, t as makeT } from '../i18n';
import type { Post } from '../lib/blog';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
  featuredFirst?: boolean;
}
const { posts, featuredFirst = false } = Astro.props;
const t = makeT(getLang(Astro.url));
---

{
  posts.length === 0 ? (
    <p>{t('blog.empty')}</p>
  ) : (
    <div class="list">
      {posts.map((p, i) => <PostCard post={p} featured={featuredFirst && i === 0} level="h2" />)}
    </div>
  )
}

<style>
  .list { display: grid; border-bottom: var(--border-width-thick) solid var(--color-rule); }
</style>
