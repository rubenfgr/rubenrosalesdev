# Desarrollo local de la API (copiar a apps/api/.env, que no se versiona). En el VPS: deploy/.env.example.
# docker run -d --name rr-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=rr -p 55432:5432 postgres:17
DATABASE_URL=postgres://postgres:dev@localhost:55432/rr
# Email de contacto y de los resúmenes del asistente (Gmail API, ver docs/formulario-contacto.md)
CONTACT_TO=
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Asistente con LLM (apagado salvo ASSISTANT_LLM_ENABLED=1). La clave solo aquí o en el VPS, nunca en el repo.
ASSISTANT_LLM_ENABLED=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=gemini-3.5-flash-lite
# ASSISTANT_LLM_PER_IP_PER_DAY=20   # en local conviene subirlo (p. ej. 500) para probar sin que se agote
ASSISTANT_LLM_PRICE_IN_PER_MTOK=0.30
ASSISTANT_LLM_PRICE_OUT_PER_MTOK=2.50
