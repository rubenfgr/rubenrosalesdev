{
  "name": "@rr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/export-knowledge.mjs && tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node ../../scripts/export-knowledge.mjs && tsup",
    "start": "node dist/index.js",
    "check": "node ../../scripts/export-knowledge.mjs && tsc --noEmit",
    "test": "node ../../scripts/export-knowledge.mjs && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.7.0",
    "@rr/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.0",
    "postgres": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
