# Copiar a /opt/apps/projects/rubenrosalesdev/.env en el VPS (no se versiona). Solo variables de entorno; nunca en el repo.
# Formulario de contacto por Gmail (OAuth2). Cómo obtener las credenciales: docs/formulario-contacto.md
CONTACT_PROVIDER=gmail
CONTACT_TO=
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Base de datos (Postgres en el mismo compose). Elige una contraseña larga y aleatoria.
POSTGRES_DB=rr
POSTGRES_USER=rr
POSTGRES_PASSWORD=
# Debe repetir los tres valores anteriores (el host «postgres» es el servicio del compose).
DATABASE_URL=postgres://rr:CAMBIAR@postgres:5432/rr
# Origen permitido para CORS. Vacío = mismo origen (lo normal: la API cuelga de /api/v1 del mismo dominio).
ALLOWED_ORIGIN=

# Asistente con LLM (fase 3 del plan; no se usa todavía)
# ASSISTANT_LLM_PROVIDER=gemini
# ASSISTANT_LLM_MODEL=gemini-3.5-flash-lite
