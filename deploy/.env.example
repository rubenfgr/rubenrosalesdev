# Copiar a /opt/apps/projects/rubenrosalesdev/.env en el VPS (no se versiona). Solo variables de entorno; nunca en el repo.
# Formulario de contacto por Gmail (OAuth2). Cómo obtener las credenciales: docs/formulario-contacto.md
CONTACT_PROVIDER=gmail
CONTACT_TO=
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Base de datos (Postgres en el mismo compose). Elige una contraseña larga y aleatoria.
POSTGRES_DB=rr
POSTGRES_USER=rr
POSTGRES_PASSWORD=
# Debe repetir los tres valores anteriores (el host «postgres» es el servicio del compose).
DATABASE_URL=postgres://rr:CAMBIAR@postgres:5432/rr
# Origen permitido para CORS. Vacío = mismo origen (lo normal: la API cuelga de /api/v1 del mismo dominio).
ALLOWED_ORIGIN=
# Sal larga y aleatoria para hashear IPs (no se guardan en claro). Cámbiala solo si aceptas que los hashes anteriores dejen de coincidir.
IP_HASH_SALT=
# Límites por IP (opcionales; valores por defecto)
# RATE_LIMIT_CHAT_PER_MIN=10
# RATE_LIMIT_LEADS_PER_HOUR=5

# Conservación (D-3): conversaciones 90 días, leads 12 meses (valores por defecto)
# CONVERSATION_RETENTION_DAYS=90
# LEAD_RETENTION_DAYS=365

# Asistente con LLM (apagado por defecto; kill switch: ASSISTANT_LLM_ENABLED distinto de 1 + reiniciar api)
# ASSISTANT_LLM_ENABLED=
# ASSISTANT_LLM_PROVIDER=gemini
# ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_MODEL=gemini-3.5-flash-lite
# ASSISTANT_LLM_MAX_OUTPUT_TOKENS=300
# Tope mensual en euros. A partir del 80 % se degrada (ollama o solo reglas); al 100 % no se llama a Gemini.
# ASSISTANT_LLM_MONTHLY_BUDGET_EUR=1
# Precio por millón de tokens (tabla oficial de Google en USD: entrada 0,30 / salida 2,50; se usa 1 USD = 1 EUR, lado conservador)
# ASSISTANT_LLM_PRICE_IN_PER_MTOK=0.30
# ASSISTANT_LLM_PRICE_OUT_PER_MTOK=2.50
# Proveedor alternativo sin coste (T-3.9)
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=
