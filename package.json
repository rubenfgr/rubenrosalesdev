{
  "name": "rubenrosales-dev",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "packageManager": "pnpm@12.12.1",
  "scripts": {
    "dev": "pnpm --filter @rr/web dev",
    "dev:api": "pnpm --filter @rr/api dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "build:prod": "pnpm --filter @rr/web build:prod && pnpm --filter @rr/api build",
    "i18n:check": "pnpm --filter @rr/web i18n:check",
    "content:new": "pnpm --filter @rr/web content:new",
    "test": "pnpm -r --if-present test",
    "e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
